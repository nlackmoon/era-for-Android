<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
 <uses-permission android:name="android.permission.INTERNET"/>
 <!-- 直接读取目录模式：不再把几 GB 的游戏复制进应用私有目录。
      Android 10 及以下用读写权限；Android 11+ 需要「所有文件访问」特殊权限。 -->
 <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32"/>
 <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
 <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"/>
 <application android:allowBackup="false" android:icon="@drawable/appicon" android:label="era for Android" android:requestLegacyExternalStorage="true" android:usesCleartextTraffic="true" android:hardwareAccelerated="true" android:supportsRtl="true"/>
</manifest>
